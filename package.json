{
  "name": "contraister",
  "version": "0.2.1",
  "description": "MCP server to cross-check an AI's answers against other AI models (Gemini, Claude, OpenAI, Grok, Mistral, DeepSeek, Groq, Together, Perplexity, OpenRouter, Ollama).",
  "type": "module",
  "main": "src/index.js",
  "bin": { "contraister": "src/index.js" },
  "files": ["src", "README.md", "LICENSE", ".env.example"],
  "engines": { "node": ">=18" },
  "scripts": { "start": "node src/index.js", "test": "node test/smoke.js", "test:live": "node test/live.js", "build:mcpb": "node scripts/build-mcpb.js" },
  "keywords": ["mcp", "model-context-protocol", "ai", "llm", "cross-check", "fact-checking", "gemini", "openai", "claude", "openrouter"],
  "author": "oscarute",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/oscarute/contrAIster.git" },
  "bugs": { "url": "https://github.com/oscarute/contrAIster/issues" },
  "homepage": "https://github.com/oscarute/contrAIster#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  }
}
